# ===== LLM 提供商：opencode（网关）| ollama（本地）=====
LLM_PROVIDER=opencode
LLM_TIMEOUT=60
# 思考模式：1=开启（慢且多轮易触发上游 400），0=关闭（默认，实测单轮快 5 倍）
LLM_THINKING=0
# ===== LLM：OpenCode Go 网关（OpenAI 兼容）=====
OPENCODE_API_KEY=your-key-here
# 网关地址，以套餐文档为准（sanity_check 会实测）
OPENCODE_BASE_URL=https://api.opencode.ai/v1
# 可选：固定网关会话 ID；不填则进程启动时自动生成
# OPENCODE_SESSION_ID=your-session-id
# 两档模型：research（主管/RAG/SQL 专家）+ summarize（web-researcher 高频调用），默认同款
MODEL_RESEARCH=deepseek-v4-flash
MODEL_SUMMARIZE=deepseek-v4-flash

# ===== SSE 事件流 =====
# 无事件判超时秒数：api 超时判定与 webui 读超时共用同一常量
STREAM_IDLE_TIMEOUT=660

# ===== API 鉴权 =====
# 留空时不鉴权（仅本机）；部署时设置，客户端通过 X-API-Key 或 Bearer 传入
API_KEY=

# ===== 搜索 =====
TAVILY_API_KEY=your-key-here
SEARCH_PROVIDER=tavily

# ===== Embedding：本地 Ollama =====
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
